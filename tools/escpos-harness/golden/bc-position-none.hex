# printBarCode("EAN13", "none", "4006381333931")   -- body only
# position "none" suppresses the human readable interpretation.
1B 61 01   # ESC a 1    centre
1D 48 00   # GS H 0     no HRI characters   ("none")
1D 66 00   # GS f 0     HRI font A (still selected; it simply has nothing to print)
1D 68 A2   # GS h 162   barcode height
1D 77 03   # GS w 3     module width
1D 6B 43 0C   # GS k 67 12   EAN13, 12 data bytes
34 30 30 36 33 38 31 33 33 33 39 33   # "400638133393"
1B 61 00   # ESC a 0    back to left

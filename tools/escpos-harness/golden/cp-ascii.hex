# FULL JOB. profile=epson, cp=ascii, cut=none, feed=0
# body: printText(12, "none", false, "é")
# US-ASCII cannot represent e acute, so the encoder's REPLACE action substitutes '?'.
# The receipt prints wrong but readable, and nothing throws mid sale.
1B 40      # ESC @      initialise
1B 74 00   # ESC t 0    code page 0 (US-ASCII is a subset of every page; 0 is the safe pick)
1B 52 00   # ESC R 0    international character set 0
1B 61 00   # ESC a 0    justification left
1B 21 00   # ESC ! 0    print mode reset
1D 61 00   # GS a 0     disable automatic status back
3F         # '?'   unmappable character replacement
